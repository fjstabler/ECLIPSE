# ============================================================================
# ECLIPSE configuration
# Copy this file to `.env` and edit. Nothing here is required to start the
# server — but you'll want the library paths at minimum.
# ============================================================================

# --- Where the server listens -----------------------------------------------
PORT=8383
# 0.0.0.0 makes ECLIPSE reachable from other devices on your network.
HOST=0.0.0.0


# --- Your media -------------------------------------------------------------
# Point these at the folders you drop films and series into. ECLIPSE watches
# them and picks up new files automatically.
#
# Separate multiple folders with `:` on macOS/Linux, `;` on Windows.
#
#   ECLIPSE_MOVIES_DIR=/mnt/media/Films
#   ECLIPSE_SERIES_DIR=/mnt/media/Series:/mnt/media/Anime
#
ECLIPSE_MOVIES_DIR=
ECLIPSE_SERIES_DIR=

# Where ECLIPSE keeps its own database and cached artwork.
ECLIPSE_DATA_DIR=data

# Watch the library folders for new files (true/false).
ECLIPSE_WATCH=true
# Scan the whole library when the server starts (true/false).
ECLIPSE_SCAN_ON_BOOT=true
# How long a file must stop changing before it's scanned, in milliseconds.
# Raise this if you copy very large files over a slow network share.
ECLIPSE_STABILITY_MS=4000
# How often to re-read the whole library, in hours. Watching a folder relies
# on filesystem events, and those do not cross a network mount — if your media
# lives on a NAS, this sweep is what actually finds new files. 0 turns it off.
ECLIPSE_SCAN_INTERVAL_HOURS=6

# Build thumbnails for the scrub bar (true/false). One sprite sheet per file,
# made in the background the first time something is played, so an untouched
# library costs nothing. Turn it off on a very small box.
ECLIPSE_TRICKPLAY=true

# --- Backups ----------------------------------------------------------------
# How often to copy the database, in hours. This is the only part of an
# ECLIPSE install that cannot be rebuilt from what's on disk: profiles, PINs,
# what everyone has watched, lists, ratings and the library setup. The last
# seven are kept, in <data dir>/backups. 0 turns it off.
ECLIPSE_BACKUP_INTERVAL_HOURS=24


# --- Metadata ---------------------------------------------------------------
# A free TMDB API key gets you posters, backdrops, synopses, cast and crew.
# Get one at https://www.themoviedb.org/settings/api
# Without it, ECLIPSE derives titles from filenames and generates its own
# artwork — everything still works, it just looks plainer.
TMDB_API_KEY=
# Affects language of synopses and which certification is shown (e.g. en-GB, en-US, de-DE).
TMDB_LANGUAGE=en-GB


# --- N.O.V.A. ---------------------------------------------------------------
# N.O.V.A.'s recommendation engine runs locally and needs no key at all.
#
# An OpenAI API key adds the conversational layer: she can then talk through
# what to watch, take constraints ("something short and funny"), and learn
# your taste over time.
#
#   1. Go to https://platform.openai.com/api-keys
#   2. Create a key (it starts with sk-...)
#   3. Paste it below, save the file, and restart the server
#
# Your key stays in this file on your own machine. It is never sent to the
# browser — only the server talks to OpenAI.
OPENAI_API_KEY=

# Which model she uses. Any chat model your key can reach will work; if the
# one below isn't available to your account, ECLIPSE will tell you in the chat
# panel and list the ones that are.
NOVA_MODEL=gpt-4o

# Optional: point at any OpenAI-compatible endpoint instead — a local model via
# LM Studio or Ollama, OpenRouter, and so on. Leave blank for OpenAI itself.
#   OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_BASE_URL=


# --- Playback ---------------------------------------------------------------
# Browsers play .mp4/.webm directly. For .mkv and similar, ECLIPSE can remux
# on the fly if ffmpeg is installed. Set to false to disable entirely.
ECLIPSE_TRANSCODE=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe


# --- Sessions ---------------------------------------------------------------
# Leave blank and ECLIPSE generates one on first run and remembers it.
# Set it explicitly if you run several instances against the same database.
ECLIPSE_SESSION_SECRET=
