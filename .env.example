# ============================================================================
# ECLIPSE configuration
# Copy this file to `.env` and edit. Nothing here is required to start the
# server — but you'll want the library paths at minimum.
# ============================================================================

# --- Where the server listens -----------------------------------------------
PORT=8383
# 0.0.0.0 makes ECLIPSE reachable from other devices on your network.
HOST=0.0.0.0


# --- Your media -------------------------------------------------------------
# Point these at the folders you drop films and series into. ECLIPSE watches
# them and picks up new files automatically, the way Jellyfin does.
#
# Separate multiple folders with `:` on macOS/Linux, `;` on Windows.
#
#   ECLIPSE_MOVIES_DIR=/mnt/media/Films
#   ECLIPSE_SERIES_DIR=/mnt/media/Series:/mnt/media/Anime
#
ECLIPSE_MOVIES_DIR=
ECLIPSE_SERIES_DIR=

# Where ECLIPSE keeps its own database and cached artwork.
ECLIPSE_DATA_DIR=data

# Watch the library folders for new files (true/false).
ECLIPSE_WATCH=true
# Scan the whole library when the server starts (true/false).
ECLIPSE_SCAN_ON_BOOT=true
# How long a file must stop changing before it's scanned, in milliseconds.
# Raise this if you copy very large files over a slow network share.
ECLIPSE_STABILITY_MS=4000


# --- Metadata ---------------------------------------------------------------
# A free TMDB API key gets you posters, backdrops, synopses, cast and crew.
# Get one at https://www.themoviedb.org/settings/api
# Without it, ECLIPSE derives titles from filenames and generates its own
# artwork — everything still works, it just looks plainer.
TMDB_API_KEY=
# Affects language of synopses and which certification is shown (e.g. en-GB, en-US, de-DE).
TMDB_LANGUAGE=en-GB


# --- NOVA -------------------------------------------------------------------
# NOVA's recommendation engine runs locally and needs no key at all.
# An Anthropic API key adds the conversational layer: NOVA can then talk
# through what to watch, take constraints ("something short and funny"), and
# learn your taste over time.  https://console.anthropic.com
ANTHROPIC_API_KEY=
NOVA_MODEL=claude-opus-5
# How much thinking NOVA does per reply: low | medium | high | xhigh | max
NOVA_EFFORT=medium


# --- Playback ---------------------------------------------------------------
# Browsers play .mp4/.webm directly. For .mkv and similar, ECLIPSE can remux
# on the fly if ffmpeg is installed. Set to false to disable entirely.
ECLIPSE_TRANSCODE=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe


# --- Sessions ---------------------------------------------------------------
# Leave blank and ECLIPSE generates one on first run and remembers it.
# Set it explicitly if you run several instances against the same database.
ECLIPSE_SESSION_SECRET=
