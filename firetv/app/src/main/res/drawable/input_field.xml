<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E1B2B" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#7C5CFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16141F" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#2A2740" />
        </shape>
    </item>
</selector>
